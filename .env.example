# Moneta Financial SaaS Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

FLASK_SECRET_KEY=change_this_to_a_secure_random_string_in_production
FLASK_ENV=production
ALLOW_AUTO_LOGIN=0
SESSION_COOKIE_SECURE=false

# Supabase / PostgreSQL Bağlantı Adresi (Tanımlıysa bulut PostgreSQL motoru kullanılır)
# Örnek: DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# MSSQL Database Connection Settings (DATABASE_URL boşsa yerel/bulut MSSQL kullanılır)
# Yerel Windows için DB_TRUSTED_CONNECTION=yes; bulut/Linux/Azure SQL için DB_USER & DB_PASSWORD doldurun.
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=localhost
DB_DATABASE=wealth_tracker_db
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Finansal Yedek Varsayılanlar (Dış API çevrimdışıyken)
DEFAULT_USD_TRY_FALLBACK=50.60

# Akıllı Fiş & Fatura Okuma (Multimodal Vision AI — Opsiyonel)
# Tanımlanmazsa sistem çevrimdışı/yedek ayrıştırıcı ile çalışmaya devam eder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

